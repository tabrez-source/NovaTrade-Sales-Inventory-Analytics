# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.log

# Virtual environments and secrets
.env
venv/
.venv/

# Large or generated data
data/raw/
data/processed/
data/sql_load/
*.csv
*.tsv
*.xlsx

# Allow documented samples
!data/sample/
!data/sample/*.csv
!data/sample/*.tsv

# SQL Server artifacts
*.bak
*.mdf
*.ldf
*.trn

# Power BI local and binary artifacts
*.pbix
*.pbit
**/.pbi/

# IDE and operating-system files
.vscode/
.idea/
.vs/
**/.vs/
*.suo
*.user
.DS_Store
Thumbs.db

# Temporary packages
*.tmp
*.temp
*.cache.pbi/
*.zip
