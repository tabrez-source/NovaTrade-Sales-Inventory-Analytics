	column FromGodown =
			
			LOOKUPVALUE(
			    'dim DimToGodown'[GodownName],
			    'dim DimToGodown'[GodownKey],
			    'fact FactInventoryMovement'[FromGodownID]
			)
		lineageTag: 210313ea-a00d-4488-b4f1-0a4c1bd22aeb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ToGodown =
			
			LOOKUPVALUE(
			    'dim DimToGodown'[GodownName],
			    'dim DimToGodown'[GodownKey],
			    'fact FactInventoryMovement'[ToGodownID]
			)
		lineageTag: ecefd35a-d326-4f0c-ab7e-2520eda073e8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column MovementGodown =
			
			SWITCH(
			    TRUE(),
			    COALESCE('fact FactInventoryMovement'[InwardQuantity], 0) > 0,
			        'fact FactInventoryMovement'[ToGodown],
			
			    COALESCE('fact FactInventoryMovement'[OutwardQuantity], 0) > 0,
			        'fact FactInventoryMovement'[FromGodown],
			
			    NOT ISBLANK('fact FactInventoryMovement'[ToGodown]),
			        'fact FactInventoryMovement'[ToGodown],
			
			    'fact FactInventoryMovement'[FromGodown]
			)
		lineageTag: 4e05b887-142c-4236-9e55-d12aaa1e3598
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

