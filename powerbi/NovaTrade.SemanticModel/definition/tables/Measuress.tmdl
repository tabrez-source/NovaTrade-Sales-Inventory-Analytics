	measure 'Top Category Revenue Share' =

			VAR CategorySales =
			    ADDCOLUMNS (
			        ALLSELECTED ( 'dim DimProduct'[CategoryName] ),
			        "@CategorySales", CALCULATE ( [Total Sales] )
			    )
			VAR TopCategorySales =
			    MAXX ( CategorySales, [@CategorySales] )
			VAR PortfolioSales =
			    CALCULATE (
			        [Total Sales],
			        ALLSELECTED ( 'dim DimProduct'[CategoryName] )
			    )
			RETURN
			DIVIDE ( TopCategorySales, PortfolioSales )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 08_Product Performance
		lineageTag: a47792c4-5e13-4c73-b7ab-92c6a38cd560

	measure 'Growing Products at Flow Risk' =

			VAR ProductSignals =
			    ADDCOLUMNS (
			        VALUES ( 'dim DimProduct'[ProductKey] ),
			        "@Revenue", CALCULATE ( [Total Sales] ),
			        "@Growth", CALCULATE ( [YoY Sales Change %] ),
			        "@NetFlow", CALCULATE ( [Net Movement Quantity] )
			    )
			RETURN
			COUNTROWS (
			    FILTER (
			        ProductSignals,
			        NOT ISBLANK ( [@Revenue] )
			            && NOT ISBLANK ( [@Growth] )
			            && NOT ISBLANK ( [@NetFlow] )
			            && [@Growth] > 0
			            && [@NetFlow] < 0
			    )
			)
		formatString: 0
		displayFolder: 10_Management Decision Center
		lineageTag: 0b7c0246-6c7a-44c7-a2ae-a166b6d6ca0e

	measure 'Revenue at Flow Risk' =

			VAR ProductSignals =
			    ADDCOLUMNS (
			        VALUES ( 'dim DimProduct'[ProductKey] ),
			        "@Revenue", CALCULATE ( [Total Sales] ),
			        "@Growth", CALCULATE ( [YoY Sales Change %] ),
			        "@NetFlow", CALCULATE ( [Net Movement Quantity] )
			    )
			RETURN
			SUMX (
			    FILTER (
			        ProductSignals,
			        NOT ISBLANK ( [@Revenue] )
			            && NOT ISBLANK ( [@Growth] )
			            && NOT ISBLANK ( [@NetFlow] )
			            && [@Growth] > 0
			            && [@NetFlow] < 0
			    ),
			    [@Revenue]
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 10_Management Decision Center
		lineageTag: 1756922f-3e83-4441-a950-26aac53f5c4c

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Revenue at Flow Risk %' =

			DIVIDE ( [Revenue at Flow Risk], [Total Sales] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 10_Management Decision Center
		lineageTag: 42fb3f4d-3afb-4b35-92f1-dff79644fca3

	measure 'Declining Products' =

			VAR ProductSignals =
			    ADDCOLUMNS (
			        VALUES ( 'dim DimProduct'[ProductKey] ),
			        "@Revenue", CALCULATE ( [Total Sales] ),
			        "@Growth", CALCULATE ( [YoY Sales Change %] )
			    )
			RETURN
			COUNTROWS (
			    FILTER (
			        ProductSignals,
			        NOT ISBLANK ( [@Revenue] )
			            && NOT ISBLANK ( [@Growth] )
			            && [@Growth] < 0
			    )
			)
		formatString: 0
		displayFolder: 10_Management Decision Center
		lineageTag: 0e295672-28d9-4455-a6f1-f3b22144e5d5

	measure 'Declining Product Revenue' =

			VAR ProductSignals =
			    ADDCOLUMNS (
			        VALUES ( 'dim DimProduct'[ProductKey] ),
			        "@Revenue", CALCULATE ( [Total Sales] ),
			        "@Growth", CALCULATE ( [YoY Sales Change %] )
			    )
			RETURN
			SUMX (
			    FILTER (
			        ProductSignals,
			        NOT ISBLANK ( [@Revenue] )
			            && NOT ISBLANK ( [@Growth] )
			            && [@Growth] < 0
			    ),
			    [@Revenue]
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 10_Management Decision Center
		lineageTag: b366a15c-3af1-4224-b199-d7eaa3206853

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Declining Product Revenue %' =

			DIVIDE ( [Declining Product Revenue], [Total Sales] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 10_Management Decision Center
		lineageTag: 292a45f3-e8b0-4a8a-b389-6ec9086952ea

	measure 'Previous Year Cross Region Sales %' =

			CALCULATE (
			    [Cross Region Sales %],
			    SAMEPERIODLASTYEAR ( 'dim DimDate'[FullDate] )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 10_Management Decision Center
		lineageTag: 50c22d03-452e-41d5-9273-ef8b38931c18

	measure 'Cross Region Exposure Change' =

			VAR PriorYearShare =
			    [Previous Year Cross Region Sales %]
			RETURN
			IF (
			    ISBLANK ( PriorYearShare ),
			    BLANK (),
			    [Cross Region Sales %] - PriorYearShare
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 10_Management Decision Center
		lineageTag: 201c91f8-2f55-48a3-9419-48b967b3ebba

	measure 'Management Action' =

			VAR ProductRevenue =
			    [Total Sales]
			VAR GrowthRate =
			    [YoY Sales Change %]
			VAR NetFlow =
			    [Net Movement Quantity]
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( ProductRevenue ), BLANK (),
			    NOT ISBLANK ( GrowthRate )
			        && GrowthRate > 0
			        && NetFlow < 0, "1 · Replenish & protect growth",
			    NOT ISBLANK ( GrowthRate )
			        && GrowthRate < 0, "2 · Recover demand",
			    "3 · Monitor"
			)
		displayFolder: 10_Management Decision Center
		lineageTag: 74cc8bce-9339-45ea-b15f-62bff642126d

	measure 'Inbound Coverage %' =

			DIVIDE ( [Total Inward Quantity], [Total Outward Quantity] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 09_Inventory Operations
		lineageTag: 7b0fe7e3-4622-4a47-9664-b44d5866db71

	measure 'Products with Flow Deficit' =

			VAR ProductFlow =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( 'dim DimProduct'[ProductKey] ),
			            "@NetFlow", CALCULATE ( [Net Movement Quantity] )
			        ),
			        [@NetFlow] < 0
			    )
			RETURN
			COUNTROWS ( ProductFlow )
		formatString: 0
		displayFolder: 09_Inventory Operations
		lineageTag: 8d842cab-cac1-419c-a40f-eb8a8866b997

	measure 'Total Movement Quantity' =
			
			[Total Inward Quantity] + [Total Outward Quantity]
		formatString: 0
		displayFolder: 03_Inventory
		lineageTag: cda3ff51-318f-49e8-9f3a-4d9e350819e8

	measure 'Movement Row Count' =
			
			COUNTROWS('fact FactInventoryMovement')
		formatString: 0
		displayFolder: 03_Inventory
		lineageTag: ec066508-6cd7-4905-80fa-52391a6d2613

	measure 'Validation Sales Split Variance' =

			VAR ExpectedSales =
			    COALESCE ( [Assigned-Region Sales], 0 )
			        + COALESCE ( [Cross Region Sales], 0 )
			RETURN
			IF (
			    ISBLANK ( [Total Sales] ),
			    BLANK (),
			    [Total Sales] - ExpectedSales
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 11_Report Validation
		lineageTag: eab0a4cf-b5bf-4cd2-bf4a-bb8a5ca58f01

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Validation Sales Split Status' =

			IF (
			    ISBLANK ( [Total Sales] ),
			    "N/A",
			    IF ( ABS ( [Validation Sales Split Variance] ) <= 1, "PASS", "FAIL" )
			)
		displayFolder: 11_Report Validation
		lineageTag: 8fe49f4d-48cb-44a7-91d0-1d5e3c1ddf02

	measure 'Validation AOV Variance' =

			IF (
			    [Sales Order Count] = 0,
			    BLANK (),
			    [Total Sales]
			        - ( [Average Order Value] * [Sales Order Count] )
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 11_Report Validation
		lineageTag: ad9f02ef-78e4-46a6-9b90-97ddd3d0a703

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Validation AOV Status' =

			IF (
			    [Sales Order Count] = 0,
			    "N/A",
			    IF ( ABS ( [Validation AOV Variance] ) <= 1, "PASS", "FAIL" )
			)
		displayFolder: 11_Report Validation
		lineageTag: cbcbbf75-9f87-486c-8990-893bcf09ef04

	measure 'Validation Sales Orphan Rows' =

			COALESCE (
			    COUNTROWS (
			        FILTER (
			            'fact FactSales',
			            ISBLANK ( RELATED ( 'dim DimDate'[DateKey] ) )
			                || ISBLANK ( RELATED ( 'dim DimProduct'[ProductKey] ) )
			                || ISBLANK ( RELATED ( 'dim DimDistributor'[DistributorKey] ) )
			                || ISBLANK ( RELATED ( 'dim DimSalesHead'[SalesHeadKey] ) )
			                || ISBLANK ( RELATED ( 'dim DimBranch'[BranchKey] ) )
			                || ISBLANK ( RELATED ( 'dim DimGodown'[GodownKey] ) )
			        )
			    ),
			    0
			)
		formatString: 0
		displayFolder: 11_Report Validation
		lineageTag: d61aed09-0556-4acd-997f-c86756366a05

	measure 'Validation Inventory Orphan Rows' =

			COALESCE (
			    COUNTROWS (
			        FILTER (
			            'fact FactInventoryMovement',
			            ISBLANK ( RELATED ( 'dim DimDate'[DateKey] ) )
			                || ISBLANK ( RELATED ( 'dim DimProduct'[ProductKey] ) )
			                || (
			                    NOT ISBLANK ( 'fact FactInventoryMovement'[FromGodownKey] )
			                        && ISBLANK ( RELATED ( 'dim DimFromGodown'[GodownKey] ) )
			                )
			                || (
			                    NOT ISBLANK ( 'fact FactInventoryMovement'[ToGodownKey] )
			                        && ISBLANK ( RELATED ( 'dim DimToGodown'[GodownKey] ) )
			                )
			        )
			    ),
			    0
			)
		formatString: 0
		displayFolder: 11_Report Validation
		lineageTag: a64e3585-e772-44c0-b655-15c8f321b706

	measure 'Validation Orphan Fact Rows' =

			[Validation Sales Orphan Rows]
			    + [Validation Inventory Orphan Rows]
		formatString: 0
		displayFolder: 11_Report Validation
		lineageTag: 7be91867-4c5d-4da2-963d-403ae5e7ae07

	measure 'Validation Relationship Integrity Status' =

			IF (
			    [Sales Row Count] + [Inventory Row Count] = 0,
			    "N/A",
			    IF ( [Validation Orphan Fact Rows] = 0, "PASS", "FAIL" )
			)
		displayFolder: 11_Report Validation
		lineageTag: 4d75f999-f09b-4bb8-a704-3fe3c34d2608

	measure 'Validation Net Flow Variance' =

			IF (
			    [Inventory Row Count] = 0,
			    BLANK (),
			    [Net Movement Quantity]
			        - ( [Total Inward Quantity] - [Total Outward Quantity] )
			)
		formatString: 0
		displayFolder: 11_Report Validation
		lineageTag: a1e2486f-78f9-411c-95d0-0611cf0f8209

	measure 'Validation Net Flow Status' =

			IF (
			    [Inventory Row Count] = 0,
			    "N/A",
			    IF ( [Validation Net Flow Variance] = 0, "PASS", "FAIL" )
			)
		displayFolder: 11_Report Validation
		lineageTag: 414bc53b-dab8-4b1e-8d7b-50796e7f630a

	measure 'Validation Raw Movement Quantity' =

			SUM ( 'fact FactInventoryMovement'[Quantity] )
		formatString: 0
		displayFolder: 11_Report Validation
		lineageTag: ec823152-b407-450d-85f3-95302d2f930b

	measure 'Validation Movement Classification Variance' =

			IF (
			    [Inventory Row Count] = 0,
			    BLANK (),
			    [Validation Raw Movement Quantity]
			        - [Total Inward Quantity]
			        - [Total Outward Quantity]
			        - [Total Transfer Quantity]
			)
		formatString: 0
		displayFolder: 11_Report Validation
		lineageTag: 76cfd3cc-a350-4e11-aa0a-8350855c090c

	measure 'Validation Movement Classification Status' =

			IF (
			    [Inventory Row Count] = 0,
			    "N/A",
			    IF (
			        [Validation Movement Classification Variance] = 0,
			        "PASS",
			        "FAIL"
			    )
			)
		displayFolder: 11_Report Validation
		lineageTag: eef6e97b-c83c-4916-bffd-3af4d8cb6e0d

	measure 'Validation Product Coverage Status' =

			VAR Coverage =
			    [Product Coverage %]
			RETURN
			IF (
			    ISBLANK ( Coverage ),
			    "N/A",
			    IF (
			        Coverage >= 0
			            && Coverage <= 1
			            && [Distinct Products Sold] <= [Product Catalog Count],
			        "PASS",
			        "FAIL"
			    )
			)
		displayFolder: 11_Report Validation
		lineageTag: 63e18788-2d13-43e7-9334-335b89fa9d0e

	measure 'Validation Tests Run' =

			INT ( [Validation Sales Split Status] <> "N/A" )
			    + INT ( [Validation AOV Status] <> "N/A" )
			    + INT ( [Validation Relationship Integrity Status] <> "N/A" )
			    + INT ( [Validation Net Flow Status] <> "N/A" )
			    + INT ( [Validation Movement Classification Status] <> "N/A" )
			    + INT ( [Validation Product Coverage Status] <> "N/A" )
		formatString: 0
		displayFolder: 11_Report Validation
		lineageTag: 39da88c1-e4ed-4784-beae-14638023ef0f

	measure 'Validation Tests Passed' =

			INT ( [Validation Sales Split Status] = "PASS" )
			    + INT ( [Validation AOV Status] = "PASS" )
			    + INT ( [Validation Relationship Integrity Status] = "PASS" )
			    + INT ( [Validation Net Flow Status] = "PASS" )
			    + INT ( [Validation Movement Classification Status] = "PASS" )
			    + INT ( [Validation Product Coverage Status] = "PASS" )
		formatString: 0
		displayFolder: 11_Report Validation
		lineageTag: 3c892c94-c842-4397-89de-7ca198898310

	measure 'Validation Tests Failed' =

			[Validation Tests Run] - [Validation Tests Passed]
		formatString: 0
		displayFolder: 11_Report Validation
		lineageTag: 1244cfd3-fb26-480f-b6ad-b07ec64a3f11

	measure 'Validation Overall Status' =

			SWITCH (
			    TRUE (),
			    [Validation Tests Run] = 0, "NO DATA",
			    [Validation Tests Failed] = 0, "PASS",
			    "REVIEW"
			)
		displayFolder: 11_Report Validation
		lineageTag: 4e126490-9671-4d0c-9666-9b8ff363ab12

	column Value
		isHidden
		formatString: 0
		lineageTag: 26e126a0-c68d-409d-b2cc-62f2db21fa50
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition Measuress = calculated
		mode: import
		source = { BLANK() }

	annotation PBI_Id = 23251035da304c7ab82b48d0f54b4fac
