	measure 'Distinct Products Sold' =
			
			DISTINCTCOUNT ( 'fact FactSales'[ProductKey] )
		formatString: 0
		displayFolder: 04_Validation
		lineageTag: b9c9612f-b13b-43e0-8625-ac0e0ed7494c

	measure 'Product Catalog Count' =

			CALCULATE (
			    DISTINCTCOUNT ( 'dim DimProduct'[ProductKey] ),
			    REMOVEFILTERS ( 'dim DimProduct' )
			)
		formatString: 0
		displayFolder: 08_Product Performance
		lineageTag: c39553f2-4ca2-41bf-9831-7c66f1c0744c

	measure 'Product Coverage %' =

			DIVIDE (
			    [Distinct Products Sold],
			    [Product Catalog Count]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08_Product Performance
		lineageTag: b645cda1-bd76-4acc-a57a-7c3e98d24dbf

	measure 'Product Coverage Display' =

			VAR ProductsSold =
			    [Distinct Products Sold]
			VAR CatalogProducts =
			    [Product Catalog Count]
			VAR CoverageRate =
			    [Product Coverage %]
			RETURN
			IF (
			    ISBLANK ( ProductsSold ),
			    "N/A",
			    FORMAT ( ProductsSold, "#,0" )
			        & " / "
			        & FORMAT ( CatalogProducts, "#,0" )
			        & " ("
			        & FORMAT ( CoverageRate, "0%" )
			        & ")"
			)
		displayFolder: 08_Product Performance
		lineageTag: 6d691914-c9f8-445d-a3d1-f27173830ac4

	measure 'Product Revenue (₹M)' =

			[Total Sales]
		formatString: "₹"0.00,,"M"
		displayFolder: 08_Product Performance
		lineageTag: 4456d40c-6c8c-41f3-84bf-edb8b7c5b352

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Product Category Tooltip' =

			SELECTEDVALUE (
