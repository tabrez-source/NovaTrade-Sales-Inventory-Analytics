	measure 'Total COGS' =
			
			SUMX (
			    'fact FactSales',
			    'fact FactSales'[Quantity] * 'fact FactSales'[UnitPrice]
			)
		displayFolder: 01_FoundationKPIs
		lineageTag: b0ebbe92-abbc-40e8-b461-3f3d2d605358

