		lineageTag: b645cda1-bd76-4acc-a57a-7c3e98d24dbf

	measure 'Product Coverage Display' =

			VAR ProductsSold =
			    [Distinct Products Sold]
			VAR CatalogProducts =
			    [Product Catalog Count]
			RETURN
			IF (
			    ISBLANK ( ProductsSold ),
			    "N/A",
			    FORMAT ( ProductsSold, "#,0" )
			        & " / "
			        & FORMAT ( CatalogProducts, "#,0" )
			)
		displayFolder: 08_Product Performance
		lineageTag: 6d691914-c9f8-445d-a3d1-f27173830ac4

