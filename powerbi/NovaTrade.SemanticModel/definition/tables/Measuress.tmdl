	measure 'Product Catalog Count' =

			CALCULATE (
			    DISTINCTCOUNT ( 'dim DimProduct'[ProductKey] ),
			    REMOVEFILTERS ( 'dim DimProduct' )
			)
		formatString: 0
		displayFolder: 08_Product Performance
		lineageTag: c39553f2-4ca2-41bf-9831-7c66f1c0744c

	measure 'Product Coverage %' =

			DIVIDE (
			    [Distinct Products Sold],
