	measure 'Average Selling Price' =
			
			DIVIDE (
			    [Total Sales],
			    [Total Quantity Sold]
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 05_Sales Analysis
		lineageTag: 6f35eaee-06ec-4b38-b1cc-c4652b2ac18f

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Product Quantity Contribution %' =
			
			DIVIDE (
			    [Total Quantity Sold],
			    CALCULATE (
			        [Total Quantity Sold],
			        ALLSELECTED ( 'dim DimProduct'[ProductName] )
			    )
			)
		displayFolder: 06_Ranking & Contribution
		lineageTag: 233a735e-a999-40cd-945b-c47284302204

