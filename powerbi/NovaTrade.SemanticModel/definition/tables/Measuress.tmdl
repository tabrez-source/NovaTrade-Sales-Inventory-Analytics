		lineageTag: c9c18c38-eb52-491e-89db-7c134897d8f5

	measure 'Total Inward Quantity' =
			
			SUM ( 'fact FactInventoryMovement'[InwardQuantity] )
		formatString: 0
		displayFolder: 03_Inventory
		lineageTag: a53e7f78-028a-4a38-8a21-841c971850b3

	measure 'Total Outward Quantity' =
			
