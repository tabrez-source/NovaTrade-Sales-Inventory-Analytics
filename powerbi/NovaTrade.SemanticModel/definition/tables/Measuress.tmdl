	measure 'Product Sales Contribution %' =
			
			DIVIDE (
			    [Total Sales],
			    CALCULATE (
			        [Total Sales],
			        ALLSELECTED ( 'dim DimProduct'[ProductName] )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 06_Ranking & Contribution
		lineageTag: ef4db39b-fda8-4e8f-a97b-7fba7703c3d4

	measure 'Product Portfolio Contribution %' =

			DIVIDE (
			    [Total Sales],
			    CALCULATE (
			        [Total Sales],
			        ALLSELECTED ( 'dim DimProduct' )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 08_Product Performance
		lineageTag: 2f255083-ed9c-4244-8362-3bd0f86ce7f7

	measure 'Top Category Revenue Share' =

			VAR CategorySales =
			    ADDCOLUMNS (
			        ALLSELECTED ( 'dim DimProduct'[CategoryName] ),
			        "@CategorySales", CALCULATE ( [Total Sales] )
			    )
			VAR TopCategorySales =
			    MAXX ( CategorySales, [@CategorySales] )
			VAR PortfolioSales =
			    CALCULATE (
			        [Total Sales],
			        ALLSELECTED ( 'dim DimProduct'[CategoryName] )
			    )
			RETURN
			DIVIDE ( TopCategorySales, PortfolioSales )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 08_Product Performance
		lineageTag: a47792c4-5e13-4c73-b7ab-92c6a38cd560

	measure 'Total Movement Quantity' =
			
