	measure 'Net Movement Quantity' =
			
			[Total Inward Quantity] - [Total Outward Quantity]
		formatString: 0
		displayFolder: 03_Inventory
		lineageTag: 9d710b46-e718-4e27-829e-1aa0463fe82d

	measure 'Sales YTD' =
			
			TOTALYTD (
			    [Total Sales],
			    'dim DimDate'[FullDate]
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 02_Time Intelligence
		lineageTag: 2ce8e44e-8119-4007-b843-c3c15da897d7

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Previous Month Sales' =
			
			VAR PrevMonthSales =
			    CALCULATE (
			        [Total Sales],
			        DATEADD ( 'dim DimDate'[FullDate], -1, MONTH )
			    )
			RETURN
			IF (
			    NOT ISINSCOPE ( 'dim DimDate'[YearMonth] ),
			    BLANK (),
			    PrevMonthSales
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 02_Time Intelligence
		lineageTag: 0e0bde2e-946d-4642-bbf0-6ff41daf639c

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'MoM Sales Change' =
			
			VAR PreviousMonthSales =
			    [Previous Month Sales]
			RETURN
			IF (
			    NOT ISINSCOPE ( 'dim DimDate'[YearMonth] ),
			    BLANK (),
			    IF (
			        ISBLANK ( PreviousMonthSales ),
			        BLANK (),
			        [Total Sales] - PreviousMonthSales
			    )
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 02_Time Intelligence
		lineageTag: 20c35abc-bea4-49db-b752-3ae0cd913f3c

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'MoM Sales Change %' =
			
			VAR PreviousMonthSales =
			    [Previous Month Sales]
			RETURN
			IF (
			    NOT ISINSCOPE ( 'dim DimDate'[YearMonth] ),
			    BLANK (),
			    IF (
			        ISBLANK ( PreviousMonthSales ),
			        BLANK (),
			        DIVIDE ( [MoM Sales Change], PreviousMonthSales )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02_Time Intelligence
		lineageTag: 48362285-e7f2-4147-ab26-9882f38a0b89

	measure 'Previous Year Sales' =
			
			CALCULATE (
			    [Total Sales],
			    SAMEPERIODLASTYEAR ( 'dim DimDate'[FullDate] )
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 02_Time Intelligence
		lineageTag: e3908046-ec6b-48b5-b932-3999d33b7a16

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'YoY Sales Change' =
			
			VAR PrevYearSales =
			    [Previous Year Sales]
			RETURN
			IF (
			    ISBLANK ( PrevYearSales ),
			    BLANK (),
			    [Total Sales] - PrevYearSales
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 02_Time Intelligence
		lineageTag: 5d91c136-19ea-4eb9-ac2f-8e89499c0051

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'YoY Sales Change %' =
			
			VAR PrevYearSales =
			    [Previous Year Sales]
			RETURN
			IF (
			    ISBLANK ( PrevYearSales ),
			    BLANK (),
			    DIVIDE ( [YoY Sales Change], PrevYearSales )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02_Time Intelligence
		lineageTag: 99becef4-5544-4035-8e3e-45dd9513f993

	measure 'YoY Sales Growth Display' =

			VAR GrowthRate =
			    [YoY Sales Change %]
			RETURN
			IF (
			    ISBLANK ( GrowthRate ),
			    "N/A",
			    FORMAT ( GrowthRate, "0.00%;-0.00%;0.00%" )
			)
		displayFolder: 02_Time Intelligence
		lineageTag: 6d6fa624-2e16-4fa9-a4b5-78ee4ae8c420

	measure 'Running Total Sales' =
			
			VAR MaxVisibleDate =
			    MAX ( 'dim DimDate'[FullDate] )
			RETURN
			CALCULATE (
			    [Total Sales],
			    FILTER (
			        ALLSELECTED ( 'dim DimDate' ),
			        'dim DimDate'[FullDate] <= MaxVisibleDate
			    )
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 02_Time Intelligence
		lineageTag: b65d2c95-fae7-4872-b43d-253d13747a23

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Average Order Value' =
			
			DIVIDE (
			    [Total Sales],
			    [Sales Order Count]
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 05_Sales Analysis
		lineageTag: f8b8603f-7d34-4881-a5fc-6be09f99a383

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Average Movement Quantity' =
			
			DIVIDE(
			    [Total Inward Quantity] + [Total Outward Quantity],
			    [Movement Row Count]
			)
		formatString: 0
		displayFolder: 05_Sales Analysis
		lineageTag: 9b6db9a0-fe48-4a57-87d8-cbf0e9c5943f

	measure 'Sales per Active Distributor' =
			
			DIVIDE (
			    [Total Sales],
			    [Active Distributors]
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		displayFolder: 05_Sales Analysis
		lineageTag: 0f7d00f8-c6bc-4332-9dfd-a67e0c558510

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Product Rank by Sales' =
			
